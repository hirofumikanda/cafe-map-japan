node_modules/
*.log
.DS_Store

# Pipeline build outputs (regenerated by the data pipeline)
pipeline/out/

# PMTiles are build outputs, except web/public/cafe.pmtiles, which is committed
# for GitHub Pages deployment (the deploy workflow does not run the pipeline;
# design.md Decision 5).
*.pmtiles
!web/public/cafe.pmtiles

# Web build outputs (regenerated by `npm run build` from src/ and node_modules/)
web/public/vendor/
web/public/*.js
